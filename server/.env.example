# ═══════════════════════════════════════════════════════════════════════
# Awedan Sahayak — Server Environment Variables
# ═══════════════════════════════════════════════════════════════════════
#
# Copy this file to server/.env and fill in your real values.
#   cp server/.env.example server/.env
#
# NEVER commit server/.env to version control.
# The root .gitignore excludes *.env files.

# ── AI Provider ──────────────────────────────────────────────────────
# Which LLM provider to use for generating Hindi legal applications.
#   "claude"   → Anthropic Claude (default, recommended)
#   "deepseek" → DeepSeek via Anthropic-compatible Messages API
AI_PROVIDER=claude

# ── API Keys ─────────────────────────────────────────────────────────
# Required when AI_PROVIDER=claude
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# Required when AI_PROVIDER=deepseek
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ── Google Cloud Vision API (for Aadhar OCR & handwriting scanning) ─
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable Vision API first: https://console.cloud.google.com/apis/library/vision.googleapis.com
GOOGLE_VISION_API_KEY=your-google-vision-api-key-here

# ── App API Secret ───────────────────────────────────────────────────
# Shared secret between the mobile app and the backend.
# The app sends this in the X-API-Key header for authentication.
# Generate a strong random string (e.g.: openssl rand -hex 32)
APP_API_SECRET=your-generated-api-secret-here

# ── Google Play Billing Verification ─────────────────────────────────
# Your app's Android package name (from app.json / build.gradle).
GOOGLE_PLAY_PACKAGE_NAME=com.mmenterprises.awedansahayak

# Service account credentials for Google Play Developer API access.
# Choose ONE of the following three methods:

# Option A: Base64-encoded service account JSON (recommended for Render).
# Encode with: base64 -w0 your-service-account.json
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=

# Option B: Raw service account JSON as an env var string.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Option C: Path to a mounted service account JSON file.
#GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/service-account.json

# How often to re-verify subscription status (hours).
SUBSCRIPTION_VERIFY_CACHE_HOURS=12

# How long to allow offline premium access (hours).
SUBSCRIPTION_OFFLINE_GRACE_HOURS=48

# ── Rate Limiting ────────────────────────────────────────────────────
# All limits are per-IP. Health endpoint is never rate-limited.

# General API limiter (all /api/* routes)
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=100

# AI generation limiter (generate-application, generate-custom-application, cleanup-ocr)
RATE_LIMIT_AI_WINDOW_MS=900000
RATE_LIMIT_AI_MAX=10

# OCR limiter (ocr-aadhar, scan-document — Google Vision API calls)
RATE_LIMIT_OCR_WINDOW_MS=1800000
RATE_LIMIT_OCR_MAX=10

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Native mobile apps (no Origin header) are always allowed.
# Leave empty to allow only no-Origin requests in production.
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# ── Server ───────────────────────────────────────────────────────────
PORT=3000

# "development" | "production" | "staging"
# In production, stack traces and verbose logs are suppressed.
NODE_ENV=development
